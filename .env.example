# Copy to ~/.config/cc-slack/.env (chmod 600). That is outside CC_ALLOWED_ROOTS, so a
# Claude session started by the bot cannot read the tokens back (see README "Security").
# Lookup order: $CC_ENV_FILE, then ~/.config/cc-slack/.env, then ./.env.

# --- Slack (from https://api.slack.com/apps -> your app) ---------------------
# OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information -> App-Level Tokens -> generate with scope connections:write
SLACK_APP_TOKEN=xapp-...

# --- Access control ------------------------------------------------------------
# Comma-separated Slack member IDs allowed to use the bot (profile -> "Copy member ID").
CC_ALLOWED_USERS=U0123456789
# Let the bot respond in channels when @mentioned (needs extra scopes, see manifest).
CC_ALLOW_CHANNELS=0

# --- Claude Code ----------------------------------------------------------------
# Working directory for new sessions when no `cwd:` prefix is given.
CC_DEFAULT_CWD=/home/ah/work
# Colon-separated directories a `cwd:` may point into (default: CC_DEFAULT_CWD).
CC_ALLOWED_ROOTS=/home/ah/work:/home/ah/projects
# Path to the claude binary (default: ~/.local/bin/claude if present, else the SDK's bundled CLI).
CC_CLI_PATH=/home/ah/.local/bin/claude
# Default model for new threads (sonnet / opus / haiku / full id). Per thread: `!model`.
#CC_MODEL=
# Permission modes users may pick from Slack (`!mode`, `mode:` prefix).
# The default three still ask you in Slack for risky actions. Adding `auto`
# lets a classifier approve actions; `bypassPermissions` approves everything.
CC_ALLOWED_MODES=default,plan,acceptEdits
# Mode for new threads (must be in CC_ALLOWED_MODES).
CC_DEFAULT_MODE=default

# --- Tuning ------------------------------------------------------------------------
CC_MAX_CONCURRENT=3          # parallel Claude Code processes
CC_PROMPT_TIMEOUT_S=3600     # auto-deny a permission prompt after this long
CC_TURN_TIMEOUT_S=0          # interrupt a turn after this long (0 = off)
CC_EDIT_INTERVAL_S=1.5       # min seconds between edits of one Slack message
CC_MSG_MAX_CHARS=3500        # split prose into a new message beyond this
CC_SHOW_TOOLS=1              # show tool-call lines in the status message
CC_STREAM_DELTAS=0           # token-level streaming (more Slack edits)
CC_STATE_FILE=state/threads.json
CC_LOG_LEVEL=INFO
